# Generated by Terraform - one upstream entry per app container
upstream shoplite {
    zone shoplite 64k;   # shared round-robin state across nginx workers
%{ for b in backends ~}
    server ${b}:8000;
%{ endfor ~}
}

server {
    listen 80;
    location / {
        proxy_pass http://shoplite;
        proxy_set_header X-Forwarded-For $remote_addr;
        add_header X-Upstream $upstream_addr always;
    }
}
