{
  "index_patterns": ["shoplite-logs-*"],
  "template": {
    "settings": { "number_of_shards": 1, "number_of_replicas": 0 },
    "mappings": {
      "properties": {
        "@timestamp":    { "type": "date" },
        "level":         { "type": "keyword" },
        "logger":        { "type": "keyword" },
        "client_ip":     { "type": "ip" },
        "method":        { "type": "keyword" },
        "path":          { "type": "keyword" },
        "query":         { "type": "keyword" },
        "status":        { "type": "integer" },
        "status_class":  { "type": "keyword" },
        "duration_ms":   { "type": "float" },
        "user":          { "type": "keyword" },
        "instance":      { "type": "keyword" },
        "service":       { "type": "keyword" },
        "env":           { "type": "keyword" },
        "log_type":      { "type": "keyword" },
        "error_message": { "type": "text" },
        "tags":          { "type": "keyword" },
        "message":       { "type": "text" }
      }
    }
  }
}
